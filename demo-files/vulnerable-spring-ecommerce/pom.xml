<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.ecommerce</groupId>
    <artifactId>vulnerable-ecommerce-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>vulnerable-ecommerce-platform</name>
    <description>Demo project with known vulnerabilities for CodeMRI testing</description>

    <dependencies>
        <!-- 
            SUPPLY-CHAIN RISK 1: Log4Shell (CVE-2021-44228)
            - What it is: Outdated logging utility (version 2.14.1).
            - Danger in Plain English: Allows remote hackers to execute arbitrary code
              and take total control of the company server over the internet.
            - Required Action: Upgrade to version 2.17.1 or higher.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.14.1</version>
        </dependency>

        <!-- 
            SUPPLY-CHAIN RISK 2: Unsafe Data Deserialization (CVE-2020-25649)
            - What it is: Outdated JSON conversion library (version 2.9.10).
            - Danger in Plain English: Allows attackers to send corrupted data packets
              that trigger unintended commands inside the application.
            - Required Action: Upgrade to version 2.14 or higher.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.9.10</version>
        </dependency>

        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>3.1.2</version>
        </dependency>

        <!-- PostgreSQL JDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.6.0</version>
        </dependency>
    </dependencies>
</project>
