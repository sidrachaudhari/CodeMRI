# CodeMRI Backend Environment Configuration
# Copy this file to backend/.env and replace placeholders with your actual secrets.

# Neon Database Connection String (PostgreSQL with psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Application Environment
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Authentication
# CodeMRI uses external authentication provider identities (e.g. Neon Auth, Clerk, Auth0)
AUTH_PROVIDER_DEFAULT=neon_auth
AUTH_JWT_SECRET=replace-with-a-secure-secret-key-in-production
AUTH_JWT_ALGORITHM=HS256

# pgvector Embedding Dimensions (e.g., 768 for nomic-embed-text / bge, 1536 for OpenAI)
CODEMRI_EMBEDDING_DIMENSIONS=768

# Google Gemini AI Studio (LLM for Code Intelligence & Explanation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

